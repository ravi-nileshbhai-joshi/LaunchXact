# ==========================================
# LaunchXact Production Environment Variables
# ==========================================

# Supabase Database & Auth (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Resend Transactional Email (Required for waitlist and audit confirmations)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="LaunchXact <hello@launchxact.com>"

# Groq AI SDK (Required for Free AI SaaS Launch Readiness Grader & Social Agent)
GROQ_API_KEY=gsk_your_groq_api_key

# Optional Payment / Checkout URLs
# NEXT_PUBLIC_CHECKOUT_URL_STARTUP_VISIBILITY_OS=https://checkout.dodopayments.com/buy/...
# DODO_PAYMENTS_API_KEY=your_dodo_api_key

# ==========================================
# Autonomous AI Social Distribution Agent
# ==========================================
# Webhook & Cron Security Secret
AGENT_CRON_SECRET=your_secret_token_here

# X (Twitter) API v2 (Required for live automated X posting)
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_SECRET=your_x_access_secret

# LinkedIn UGC / REST API (Required for live LinkedIn posting)
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_URN=urn:li:person:your_member_id

# Indie Hackers Automation (Optional: Session cookie or Webhook)
IH_SESSION_COOKIE=your_ih_session_cookie_value
# IH_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
