# ==========================================
# LaunchXact Production Environment Variables
# ==========================================

# Supabase Database & Auth (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Resend Transactional Email (Required for waitlist and audit confirmations)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="LaunchXact <hello@launchxact.com>"

# Groq AI SDK (Required for Free AI SaaS Launch Readiness Grader)
GROQ_API_KEY=gsk_your_groq_api_key

# Optional Payment / Checkout URLs
# NEXT_PUBLIC_CHECKOUT_URL_STARTUP_VISIBILITY_OS=https://checkout.dodopayments.com/buy/...
# DODO_PAYMENTS_API_KEY=your_dodo_api_key
